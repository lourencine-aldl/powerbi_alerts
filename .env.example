# Power BI
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=
PBI_BASE_URL=https://api.powerbi.com/v1.0/myorg

# Aplicação
APP_TIMEZONE=America/Bahia
DATABASE_URL=sqlite:///data/powerbi_alerts.db
REQUEST_TIMEOUT_SECONDS=30
REQUEST_MAX_RETRIES=3

# Diagnóstico por IA
LLM_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=destinatario@empresa.com
